{
  "name": "sandbar",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": ["apps/*", "packages/*", "packages/providers/*"],
  "scripts": {
    "check": "bun run --filter '@sandbar/*' check",
    "test": "bun test",
    "build": "bun run --filter '@sandbar/web' build && bun run --filter '@sandbar/server' build",
    "dev": "bun --watch apps/server/src/index.ts",
    "start": "bun apps/server/dist/index.js"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "drizzle-kit": "1.0.0-beta.22",
    "typescript": "5.9.3"
  }
}
