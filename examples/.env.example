# Copy to examples/.env.local. Scripts load that file explicitly.
# Configure only the sandbox provider selected by --provider.

# Daytona: choose an active Linux snapshot available in this region.
DAYTONA_API_KEY=""
DAYTONA_TARGET=us
DAYTONA_SNAPSHOT=daytona-small

# E2B: public base is the default; optionally select a ready template.
E2B_API_KEY=""
E2B_TEMPLATE_ID=base

# Explicit anonymous free model; no model API key required.
OPENCODE_MODEL=opencode/nemotron-3.5-lightning-free

# Optional keyed model: replace OPENCODE_MODEL above with provider/model-id,
# name its key variable below, and set that variable in this file.
# Only this named model key is forwarded to the sandbox.
# OPENCODE_API_KEY_ENV=ANTHROPIC_API_KEY
# ANTHROPIC_API_KEY=
