{
  "name": "sandbar-adapter",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./portable": {
      "types": "./dist/portable.d.ts",
      "import": "./dist/portable.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "scripts": {
    "check": "tsc -p tsconfig.json",
    "build": "rm -rf dist && bun build src/index.ts src/testing.ts src/portable.ts --target node --format esm --outdir dist --external zod && tsc -p tsconfig.build.json --noEmit false --declaration --emitDeclarationOnly --outDir dist && bun ../../scripts/rewrite-declarations.mjs"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pandemicsyn/sandbar.git",
    "directory": "packages/adapter"
  },
  "description": "Public adapter definitions, validation, and conformance testing for Sandbar.",
  "homepage": "https://sandbarsdk.dev/docs/guides/write-an-adapter/",
  "bugs": {
    "url": "https://github.com/pandemicsyn/sandbar/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "types": "./dist/index.d.ts"
}
