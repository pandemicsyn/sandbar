{
  "name": "sandbar-sdk",
  "version": "0.7.0",
  "private": false,
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "check": "tsc -p tsconfig.json",
    "build": "rm -rf dist && bun build src/index.ts --target node --format esm --splitting --outdir dist --external @sandbar-sdk/adapter --external zod --external @opentelemetry/api && tsc -p tsconfig.json --noEmit false --declaration --emitDeclarationOnly --outDir dist && bun ../../scripts/rewrite-declarations.mjs"
  },
  "dependencies": {
    "@sandbar-sdk/adapter": "workspace:*",
    "zod": "4.6.5",
    "@opentelemetry/api": "1.9.1"
  },
  "devDependencies": {
    "@sandbar/provider-fake": "workspace:*",
    "@sandbar-sdk/daytona": "workspace:*",
    "@sandbar-sdk/e2b": "workspace:*"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pandemicsyn/sandbar.git",
    "directory": "packages/sdk"
  },
  "description": "Provider-neutral SDK for direct sandbox access.",
  "homepage": "https://sandbarsdk.dev/docs/direct-quickstart/",
  "bugs": {
    "url": "https://github.com/pandemicsyn/sandbar/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "types": "./dist/index.d.ts"
}
