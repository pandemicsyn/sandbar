{
  "name": "sandbar-sdk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./direct": {
      "types": "./dist/direct.d.ts",
      "import": "./dist/direct.js"
    },
    "./remote": {
      "types": "./dist/remote.d.ts",
      "import": "./dist/remote.js"
    }
  },
  "scripts": {
    "check": "tsc -p tsconfig.json",
    "build": "rm -rf dist && bun build src/index.ts src/direct.ts src/remote.ts --target node --format esm --splitting --outdir dist --external '@sandbar/*' --external zod && tsc -p tsconfig.json --noEmit false --declaration --emitDeclarationOnly --outDir dist && bun ../../scripts/rewrite-declarations.mjs"
  },
  "dependencies": {
    "@sandbar/adapter": "workspace:*",
    "@sandbar/contracts": "workspace:*",
    "@sandbar/core": "workspace:*",
    "@sandbar/provider-spi": "workspace:*",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@sandbar/provider-fake": "workspace:*"
  }
}
