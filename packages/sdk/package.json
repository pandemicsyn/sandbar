{
  "name": "sandbar-sdk",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./service-support": {
      "types": "./dist/service-support.d.ts",
      "import": "./dist/service-support.js"
    },
    "./daytona": {
      "types": "./dist/daytona.d.ts",
      "import": "./dist/daytona.js"
    },
    "./modal": {
      "types": "./dist/modal.d.ts",
      "import": "./dist/modal.js"
    }
  },
  "scripts": {
    "check": "tsc -p tsconfig.json",
    "build": "rm -rf dist && bun build src/index.ts src/service-support.ts src/daytona.ts src/modal.ts --target node --format esm --splitting --outdir dist --external sandbar-adapter --external modal --external @grpc/grpc-js --external zod && tsc -p tsconfig.json --noEmit false --declaration --emitDeclarationOnly --outDir dist && bun ../../scripts/rewrite-declarations.mjs"
  },
  "dependencies": {
    "@grpc/grpc-js": "1.14.5",
    "sandbar-adapter": "workspace:*",
    "zod": "4.6.5",
    "modal": "0.10.1"
  },
  "devDependencies": {
    "@sandbar/provider-fake": "workspace:*",
    "@sandbar/provider-daytona": "workspace:*",
    "@sandbar/provider-modal": "workspace:*"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pandemicsyn/sandbar.git",
    "directory": "packages/sdk"
  },
  "description": "Sandbar SDK for direct sandbox access with built-in Daytona and Modal adapters.",
  "homepage": "https://sandbarsdk.dev/docs/direct-quickstart/",
  "bugs": {
    "url": "https://github.com/pandemicsyn/sandbar/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "types": "./dist/index.d.ts"
}
