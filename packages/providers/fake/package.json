{
  "name": "@sandbar/provider-fake",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./adapter": {
      "types": "./dist/adapter.d.ts",
      "import": "./dist/adapter.js"
    }
  },
  "scripts": {
    "check": "tsc -p tsconfig.json",
    "build": "rm -rf dist && bun build src/index.ts src/client.ts src/server.ts src/adapter.ts --target node --format esm --outdir dist --external '@sandbar/*' --external zod && tsc -p tsconfig.build.json --noEmit false --declaration --emitDeclarationOnly --outDir dist && bun ../../../scripts/rewrite-declarations.mjs"
  },
  "dependencies": {
    "@sandbar/contracts": "workspace:*",
    "@sandbar/provider-spi": "workspace:*",
    "zod": "4.6.5",
    "@sandbar/adapter": "workspace:*"
  }
}
