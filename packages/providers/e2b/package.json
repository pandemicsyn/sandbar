{
  "name": "@sandbar-sdk/e2b",
  "version": "0.6.0",
  "private": false,
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "check": "tsc -p tsconfig.json",
    "build": "rm -rf dist && bun build src/index.ts --target node --format esm --outdir dist --external @sandbar-sdk/adapter --external e2b --external zod && tsc -p tsconfig.build.json --noEmit false --declaration --emitDeclarationOnly --outDir dist && bun ../../../scripts/rewrite-declarations.mjs"
  },
  "dependencies": {
    "@sandbar-sdk/adapter": "workspace:*",
    "e2b": "2.51.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "sandbar-sdk": "workspace:*"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pandemicsyn/sandbar.git",
    "directory": "packages/providers/e2b"
  },
  "bugs": {
    "url": "https://github.com/pandemicsyn/sandbar/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "Official E2B adapter for Sandbar.",
  "types": "./dist/index.d.ts"
}
